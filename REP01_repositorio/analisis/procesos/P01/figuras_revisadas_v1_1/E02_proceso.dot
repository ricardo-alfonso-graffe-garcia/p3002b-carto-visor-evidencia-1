digraph proceso {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", labelloc="t", label="Investigar cómo se organizan salidas de compra de alimentos · E02\nProceso descrito según la entrevista"];
node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b", fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#475569", arrowsize=0.7];
"P01-E02-N001" [id="P01-E02-N001", label="Reconocer una pregunta que\nseguir\nP01-E02-N001\nInvestigadora / Colega investigadora", shape=oval, fillcolor="#dcfce7", tooltip="La investigadora y su colega revisan conversaciones iniciales y deciden seguir una pregunta; el interés general anterior no era todavía trabajo delimitado."];
"P01-E02-N002" [id="P01-E02-N002", label="Escribir la pregunta y la pauta\nP01-E02-N002\nInvestigadora / Colega investigadora", shape=box, fillcolor="#eff6ff", tooltip="Preparan una pregunta de trabajo y una hoja breve para reconstruir una salida concreta, compras, lugares y explicaciones."];
"P01-E02-N003" [id="P01-E02-N003", label="Invitar y acordar participación\nP01-E02-N003\nInvestigadora / Colega investigadora /\nColaboradora de campo / Personas de\nlos casos", shape=box, fillcolor="#eff6ff", tooltip="Buscan personas por contactos del equipo y referencias de otras personas; acuerdan conversar y, según posibilidad y voluntad, acompañar."];
"P01-E02-N004" [id="P01-E02-N004", label="Conversar y acompañar según\nocasión\nP01-E02-N004\nInvestigadora / Colega investigadora /\nColaboradora de campo / Personas de\nlos casos", shape=box, fillcolor="#eff6ff", tooltip="Conversan para situar compras y acompañan algunas salidas. Una se conoció por conversaciones antes y después sin acompañar; otra tuvo acompañamiento temprano. Evitan preguntar cada movimiento."];
"P01-E02-N005" [id="P01-E02-N005", label="Seguir una salida y\nreconstruirla\nP01-E02-N005\nInvestigadora / Personas de los casos", shape=box, fillcolor="#eff6ff", tooltip="En el caso desarrollado, registra actividades y decisiones, escucha vínculo entre visita y compra y observa compras pesadas al final. Al volver revisan el orden con la persona, que aclara que otras veces compra cerca y vuelve."];
"P01-E02-N006" [id="P01-E02-N006", label="Reescribir notas y discutir\ndiferencias\nP01-E02-N006\nInvestigadora / Colega investigadora /\nColaboradora de campo\nPráctica general declarada", shape=box, fillcolor="#eff6ff", tooltip="Quien estuvo reconstruye notas legibles separando visto, dicho y dudas. Discuten diferencias de atención sin borrarlas en una versión única y usan hoja sencilla para localizar casos."];
"P01-E02-N007" [id="P01-E02-N007", label="Precisar qué tiempos comparar\nP01-E02-N007\nInvestigadora / Colega investigadora", shape=diamond, fillcolor="#fef3c7", tooltip="La colega cuestiona desde dónde y para qué se llega; revisan inicios de salidas y dejan de comparar como equivalentes tiempos desde vivienda y tiempos tras visita."];
"P01-E02-N008" [id="P01-E02-N008", label="Relacionar actividades y otros\ncasos\nP01-E02-N008\nInvestigadora / Colega investigadora", shape=box, fillcolor="#eff6ff", tooltip="Hacen esquema con secuencia y razones, los sitúan en mapa y contrastan otros casos: alguno es comprar y volver. Sustituyen la causa tajante visita familiar por relación acotada entre actividades."];
"P01-E02-N009" [id="P01-E02-N009", label="Revisar la pregunta si cambia la\nlectura\nP01-E02-N009\nInvestigadora / Colega investigadora\nPráctica general declarada", shape=diamond, fillcolor="#fef3c7", tooltip="Mientras siguen las salidas, evalúan si una distinción modifica interpretación; en ese caso vuelven al material anterior y ajustan próximas preguntas."];
"P01-E02-N010" [id="P01-E02-N010", label="Conservar lo claro y lo no\nresuelto\nP01-E02-N010\nInvestigadora / Colega investigadora", shape=box, fillcolor="#eff6ff", tooltip="Encuentran notas suficientemente claras y siguen sin reformular. Conservan ambigüedad de le acomodaba más y pendientes que no pueden preguntar; no imputan desde otros casos."];
"P01-E02-N011" [id="P01-E02-N011", label="Acotar qué puede sostenerse\nP01-E02-N011\nInvestigadora / Colega investigadora", shape=diamond, fillcolor="#fef3c7", tooltip="La secuencia reconocida, notas concordantes y explicación permiten descripción acotada; no prueban repetición semanal, visita determinante ni lugar objetivamente más barato."];
"P01-E02-N012" [id="P01-E02-N012", label="Escribir y preparar la\npresentación\nP01-E02-N012\nInvestigadora / Colega investigadora", shape=box, fillcolor="#eff6ff", tooltip="Producen texto y presentación con esquemas, relaciones y diferencias. Omiten viviendas y recorridos identificadores innecesarios."];
"P01-E02-N013" [id="P01-E02-N013", label="Presentar y recibir objeciones\nP01-E02-N013\nInvestigadora / Colega investigadora /\nComentaristas de investigación", shape=box, fillcolor="#eff6ff", tooltip="Muestran lectura de casos en grupo de discusión. Una pregunta cuestiona alternativas conocidas y posibles: no se habían reconstruido todas. La crítica no decide por el equipo."];
"P01-E02-N014" [id="P01-E02-N014", label="Revisar descripciones con\nalgunas personas\nP01-E02-N014\nInvestigadora / Colega investigadora /\nPersonas de los casos", shape=box, fillcolor="#eff6ff", tooltip="Comentar brevemente con algunas personas permite que una cuestione complicada: era normal para ella. Retiran el adjetivo y describen actividades, sin revisión completa ni acuerdo académico total."];
"P01-E02-N015" [id="P01-E02-N015", label="Ajustar conclusiones y\nprocedencias\nP01-E02-N015\nInvestigadora", shape=box, fillcolor="#eff6ff", tooltip="Después de la discusión, ajusta frases que pasaban de una salida a las personas eligen y distingue acompañamiento de lo contado sobre otras ocasiones."];
"P01-E02-N016" [id="P01-E02-N016", label="Cerrar este resultado de\ninvestigación\nP01-E02-N016\nInvestigadora", shape=oval, fillcolor="#e2e8f0", tooltip="La presentación y los ajustes posteriores del texto completan un resultado reconocible para esta conversación; el tema permanece abierto."];
"P01-E02-N001" -> "P01-E02-N002" [id="P01-E02-R001", label="", tooltip="P01-E02-R001: Tras revisar conversaciones escriben la pregunta y hoja."];
"P01-E02-N002" -> "P01-E02-N003" [id="P01-E02-R002", label="", tooltip="P01-E02-R002: Después de preparar pauta buscan personas que quieran conversar."];
"P01-E02-N003" -> "P01-E02-N004" [id="P01-E02-R003", label="Conversación y\nacompañamiento según\nconsentimiento y ocasión.", tooltip="P01-E02-R003: La forma de participación responde a disponibilidad y voluntad."];
"P01-E02-N004" -> "P01-E02-N005" [id="P01-E02-R004", label="\nOrganización analítica", tooltip="P01-E02-R004: Se abre el caso ilustrativo dentro de las actividades de campo; no todo caso pasó por él.", color="#a16207", style=dashed];
"P01-E02-N005" -> "P01-E02-N006" [id="P01-E02-R005", label="\nOrganización analítica", tooltip="P01-E02-R005: La reconstrucción relatada se integra en la práctica de revisar notas; separar ambos niveles es analítico.", color="#a16207", style=dashed];
"P01-E02-N006" -> "P01-E02-N007" [id="P01-E02-R006", label="\nOrganización analítica", tooltip="P01-E02-R006: Las notas alimentan una decisión de comparabilidad; no se fija que todas estuvieran terminadas.", color="#a16207", style=dashed];
"P01-E02-N004" -> "P01-E02-N009" [id="P01-E02-R008", label="Se superponen", tooltip="P01-E02-R008: La revisión de pregunta y la comparación comienzan durante las salidas.", style=dotted, dir=none, constraint=false];
"P01-E02-N009" -> "P01-E02-N002" [id="P01-E02-R009", label="Retorno", tooltip="P01-E02-R009: Distinguir nuevas situaciones modifica lo que interesa preguntar.", style=dashed, color="#2563eb", constraint=false, xlabel="P01-E02-R009"];
"P01-E02-N009" -> "P01-E02-N006" [id="P01-E02-R010", label="Retorno", tooltip="P01-E02-R010: Si cambia interpretación vuelven al material anterior.", style=dashed, color="#2563eb", constraint=false, xlabel="P01-E02-R010"];
"P01-E02-N006" -> "P01-E02-N010" [id="P01-E02-R011", label="\nOrganización analítica", tooltip="P01-E02-R011: La revisión también permite seguir con lo claro o conservar dudas.", color="#a16207", style=dashed];
"P01-E02-N008" -> "P01-E02-N011" [id="P01-E02-R012", label="\nOrganización analítica", tooltip="P01-E02-R012: Los apoyos de esa salida delimitan lo que puede afirmarse.", color="#a16207", style=dashed];
"P01-E02-N010" -> "P01-E02-N011" [id="P01-E02-R013", label="\nOrganización analítica", tooltip="P01-E02-R013: Conservar claro y pendiente acota afirmaciones sin completar ausencias.", color="#a16207", style=dashed];
"P01-E02-N011" -> "P01-E02-N012" [id="P01-E02-R014", label="\nOrganización analítica", tooltip="P01-E02-R014: Comunican relaciones acotadas y diferencias sin jerarquía general.", color="#a16207", style=dashed];
"P01-E02-N012" -> "P01-E02-N006" [id="P01-E02-R015", label="Retorno", tooltip="P01-E02-R015: Escribir hace volver a los casos.", style=dashed, color="#2563eb", constraint=false, xlabel="P01-E02-R015"];
"P01-E02-N012" -> "P01-E02-N013" [id="P01-E02-R016", label="", tooltip="P01-E02-R016: El texto y esquemas preparados se presentan."];
"P01-E02-N013" -> "P01-E02-N015" [id="P01-E02-R017", label="", tooltip="P01-E02-R017: La escritura de conclusiones y procedencia cambia después de la discusión."];
"P01-E02-N014" -> "P01-E02-N012" [id="P01-E02-R018", label="Retorno", tooltip="P01-E02-R018: La aclaración de quien hizo el recorrido modifica su descripción; no se atribuye aprobación total.", style=dashed, color="#2563eb", constraint=false, xlabel="P01-E02-R018"];
"P01-E02-N015" -> "P01-E02-N016" [id="P01-E02-R019", label="", tooltip="P01-E02-R019: Se incluye el ajuste posterior en el límite de resultado reconocido."];
{ rank=same; "P01-E02-N004"; "P01-E02-N009"; }
{ rank=same; "P01-E02-N007"; "P01-E02-N008"; "P01-E02-N010"; }
{ rank=same; "P01-E02-N012"; "P01-E02-N014"; }
}
