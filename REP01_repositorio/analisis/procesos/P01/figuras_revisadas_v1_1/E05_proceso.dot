digraph proceso {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", labelloc="t", label="Hacer espacio para mirar libros y compartir una tarde · E05\nProceso descrito según la entrevista"];
node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b", fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#475569", arrowsize=0.7];
"P01-E05-N001" [id="P01-E05-N001", label="Querer mirar otro libro\nP01-E05-N001\nPersona que propone la salida", shape=oval, fillcolor="#dcfce7", tooltip="Después de terminar libro anterior surge deseo de ir a mirar, sin título concreto. Este es el inicio que reconoce, aunque la salida todavía no está formada."];
"P01-E05-N002" [id="P01-E05-N002", label="Proponer por mensaje a su\namistad\nP01-E05-N002\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Pensó ir por su cuenta, recordó pendiente de verse y escribió una propuesta abierta preguntando si quería acompañarla."];
"P01-E05-N003" [id="P01-E05-N003", label="Revisar pendientes mientras\nacuerdan\nP01-E05-N003\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Mira pendientes, responde y espera revisión ajena. Corrige su relato: no aceptó primero para revisar después; la revisión fue durante acuerdo del día."];
"P01-E05-N004" [id="P01-E05-N004", label="Encontrar tarde y proponer\nlibrería\nP01-E05-N004\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Una opción no acomodó y hallaron otra. Propuso librería conocida por experiencia de poder recorrer estantes y detenerse, sin recordar títulos ni precios."];
"P01-E05-N005" [id="P01-E05-N005", label="Revisar horario y acordar lo\nnecesario\nP01-E05-N005\nPersona que propone la salida /\nAmistad acompañante", shape=diamond, fillcolor="#fef3c7", tooltip="Consulta horario en página propia y ve tarde compatible; fuente y margen al cierre bastan sin llamar. Comunica nombre, referencia y hora; acuerdan día, hora y entrada."];
"P01-E05-N006" [id="P01-E05-N006", label="Dejar la segunda parada abierta\nP01-E05-N006\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="La amistad acepta librería y propone decidir lo de después allí; E05 acuerda. No fijan segundo lugar porque desconocen cuánto querrán mirar o si tendrán ganas."];
"P01-E05-N007" [id="P01-E05-N007", label="Considerar qué llevar\nP01-E05-N007\nPersona que propone la salida", shape=box, fillcolor="#eff6ff", tooltip="Piensa en sus pertenencias habituales y en dejar espacio para un libro si lo encuentra."];
"P01-E05-N008" [id="P01-E05-N008", label="Salir y calcular la llegada\nconocida\nP01-E05-N008\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Después de reconfirmar, cada quien sale desde donde está. La participante calcula su llegada con base en lo que suele tardar por esa zona, sin una búsqueda especial del camino."];
"P01-E05-N009" [id="P01-E05-N009", label="Entrar, avisar y encontrarse\nP01-E05-N009\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Llega antes, entra y avisa que mirará cerca de entrada; al llegar su amistad se encuentran ahí. El aviso precisa la referencia acordada."];
"P01-E05-N010" [id="P01-E05-N010", label="Mirar libros juntos y por\nseparado\nP01-E05-N010\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Se saludan y miran; luego se separan según intereses y se acercan para enseñar algo, manteniendo salida compartida."];
"P01-E05-N011" [id="P01-E05-N011", label="Preguntar por una sección y\nseguir\nP01-E05-N011\nPersona que propone la salida /\nAmistad acompañante / Personal de la\nlibrería", shape=box, fillcolor="#eff6ff", tooltip="En algún momento la amistad pregunta por sección; personal indica dónde y después vuelven a separarse para mirar."];
"P01-E05-N012" [id="P01-E05-N012", label="Leer opciones y decidir por\ninterés y precio\nP01-E05-N012\nPersona que propone la salida", shape=diamond, fillcolor="#fef3c7", tooltip="Toma varios libros, lee contraportadas y páginas; uno no la atrapa, otro sí. Revisa precio antes de decidir, sin reseñas ni autorización de amistad."];
"P01-E05-N013" [id="P01-E05-N013", label="Acordar salir y pagar el libro\nP01-E05-N013\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Ya eligió uno y amistad terminó de mirar. Preguntan si quieren seguir dentro y, al no tener pendientes, paga y salen."];
"P01-E05-N014" [id="P01-E05-N014", label="Renovar ganas de conversar y\ncaminar cerca\nP01-E05-N014\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Afuera retoman tomar algo y, con ganas de conversar, buscan caminando sin convertirlo en otro traslado."];
"P01-E05-N015" [id="P01-E05-N015", label="Mirar, preguntar y escuchar para\nquedarse\nP01-E05-N015\nPersona que propone la salida /\nAmistad acompañante / Persona que\nrecibe en segundo lugar", shape=diamond, fillcolor="#fef3c7", tooltip="Caminan, ven opción, oferta y mesa; dentro preguntan si pueden usarla y reciben sí. Escucha ambiente y comprueba que pueden hablar sin elevar mucho voz; decide ahí."];
"P01-E05-N016" [id="P01-E05-N016", label="Tomar algo y despedirse\nP01-E05-N016\nPersona que propone la salida /\nAmistad acompañante", shape=oval, fillcolor="#e2e8f0", tooltip="Después de conversar y tomar algo se despiden y cada quien sigue su camino. Ese es el cierre; leer libro en casa fue otra actividad."];
"P01-E05-N017" [id="P01-E05-N017", label="Reconfirmar que el plan sigue en\npie\nP01-E05-N017\nPersona que propone la salida /\nAmistad acompañante", shape=box, fillcolor="#eff6ff", tooltip="Al acercarse la salida, se confirman mutuamente que el acuerdo sigue vigente. La frase siguiente sitúa después la salida de cada quien."];
"P01-E05-N001" -> "P01-E05-N002" [id="P01-E05-R001", label="", tooltip="P01-E05-R001: La intención toma forma de salida al enviar mensaje."];
"P01-E05-N002" -> "P01-E05-N004" [id="P01-E05-R003", label="", tooltip="P01-E05-R003: La respuesta favorable abre ajuste de tarde y luego propuesta de librería."];
"P01-E05-N003" -> "P01-E05-N004" [id="P01-E05-R004", label="Se superponen", tooltip="P01-E05-R004: Revisa pendientes mientras acuerdan el día, sin aceptación previa a esa revisión.", style=dotted, dir=none, constraint=false];
"P01-E05-N004" -> "P01-E05-N005" [id="P01-E05-R005", label="\nOrganización analítica", tooltip="P01-E05-R005: Tras proponer destino revisa horario antes de acordar hora; descomposición del mismo acuerdo.", color="#a16207", style=dashed];
"P01-E05-N005" -> "P01-E05-N006" [id="P01-E05-R006", label="Se superponen", tooltip="P01-E05-R006: El alcance abierto forma parte del mismo acuerdo, sin afirmar etapa posterior.", style=dotted, dir=none, constraint=false];
"P01-E05-N005" -> "P01-E05-N017" [id="P01-E05-R007", label="", tooltip="P01-E05-R007: Después del acuerdo, al acercarse la ocasión reconfirman que sigue en pie; la salida se representa por separado."];
"P01-E05-N007" -> "P01-E05-N008" [id="P01-E05-R008", label="\nOrganización analítica", tooltip="P01-E05-R008: La preparación material se ubica antes de salir sin fijarla después de revisar agenda.", color="#a16207", style=dashed];
"P01-E05-N008" -> "P01-E05-N009" [id="P01-E05-R009", label="", tooltip="P01-E05-R009: Después de salir, llega antes y avisa para encontrarse."];
"P01-E05-N009" -> "P01-E05-N010" [id="P01-E05-R010", label="", tooltip="P01-E05-R010: Tras encontrarse se saludan y miran."];
"P01-E05-N010" -> "P01-E05-N011" [id="P01-E05-R011", label="Se superponen", tooltip="P01-E05-R011: Consulta de sección ocurre durante exploración, sin orden exacto dentro de ella.", style=dotted, dir=none, constraint=false];
"P01-E05-N010" -> "P01-E05-N012" [id="P01-E05-R012", label="Se superponen", tooltip="P01-E05-R012: Leer y revisar precio se sitúan dentro de mirar, no después de terminar de explorar.", style=dotted, dir=none, constraint=false];
"P01-E05-N012" -> "P01-E05-N013" [id="P01-E05-R013", label="", tooltip="P01-E05-R013: Elegido libro y terminada exploración de ambas partes, acuerdan salir y paga."];
"P01-E05-N013" -> "P01-E05-N014" [id="P01-E05-R014", label="", tooltip="P01-E05-R014: Afuera vuelven a preguntar si desean continuar; acuerdo previo no obliga."];
"P01-E05-N014" -> "P01-E05-N015" [id="P01-E05-R015", label="", tooltip="P01-E05-R015: Caminar cerca lleva a mirar una opción y comprobar mesa/ambiente presentes."];
"P01-E05-N015" -> "P01-E05-N016" [id="P01-E05-R016", label="", tooltip="P01-E05-R016: Confirmadas condiciones, toman algo y luego se despiden; no añade evaluación formal."];
"P01-E05-N017" -> "P01-E05-N008" [id="P01-E05-R017", label="", tooltip="P01-E05-R017: El mismo párrafo declara la confirmación y, después, que cada quien salió. No ordena la preparación material frente a confirmar."];
{ rank=same; "P01-E05-N003"; "P01-E05-N004"; }
{ rank=same; "P01-E05-N005"; "P01-E05-N006"; }
{ rank=same; "P01-E05-N007"; "P01-E05-N017"; }
{ rank=same; "P01-E05-N010"; "P01-E05-N011"; "P01-E05-N012"; }
}
