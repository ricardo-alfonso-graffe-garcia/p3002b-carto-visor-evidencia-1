digraph proceso {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", labelloc="t", label="Construir, realizar y cerrar tres encuentros culturales · E03\nProceso descrito según la entrevista"];
node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b", fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#475569", arrowsize=0.7];
"P01-E03-N001" [id="P01-E03-N001", label="Recibir la invitación a regresar\nP01-E03-N001\nCoordinadora / Dos interlocutores del\nespacio", shape=oval, fillcolor="#dcfce7", tooltip="La nueva conversación para volver al espacio inicia la serie; la actividad anterior es antecedente."];
"P01-E03-N002" [id="P01-E03-N002", label="Construir una propuesta con el\nequipo\nP01-E03-N002\nCoordinadora / Dos interlocutores del\nespacio / Mediadora de lectura /\nCompañera de programación", shape=box, fillcolor="#eff6ff", tooltip="Lleva las opciones generales al equipo; mediadora propone textos breves y emerge tema de recorridos a partir de experiencias antes escuchadas. Revisan propuesta con programación y vuelven a conversar con anfitriones."];
"P01-E03-N003" [id="P01-E03-N003", label="Revisar capacidad y fechas del\nequipo\nP01-E03-N003\nCoordinadora / Mediadora de lectura /\nCompañera de programación", shape=diamond, fillcolor="#fef3c7", tooltip="Revisan compromisos primero y calendario con fechas concretas después. Consideran un cuarto encuentro y mantienen tres porque ampliar requería otro acuerdo."];
"P01-E03-N004" [id="P01-E03-N004", label="Visitar y valorar salón y patio\nP01-E03-N004\nCoordinadora / Dos interlocutores del\nespacio", shape=box, fillcolor="#eff6ff", tooltip="Vuelven al lugar a hora parecida, prueban escucha y acomodo y reconocen entradas; comparan amplitud y paso del patio con el salón próximo a entrada."];
"P01-E03-N005" [id="P01-E03-N005", label="Comprobar uso en las tres fechas\nP01-E03-N005\nCoordinadora / Dos interlocutores del\nespacio", shape=box, fillcolor="#eff6ff", tooltip="Preguntan por actividades previstas y reciben confirmación del salón en las tres fechas. La coordinadora vuelve a un mensaje sobre la hora del grupo previo antes de cerrar horario."];
"P01-E03-N006" [id="P01-E03-N006", label="Consultar horarios a algunas\ninteresadas\nP01-E03-N006\nCoordinadora / Mediadora de lectura /\nPersonas consultadas antes", shape=box, fillcolor="#eff6ff", tooltip="Cruzan espacio y equipo y preguntan entre dos opciones a algunas personas de actividad anterior. Las respuestas favorecen tarde entre semana; sábado no aporta más posibilidad y exige ajustes."];
"P01-E03-N007" [id="P01-E03-N007", label="Preparar y aclarar la invitación\nP01-E03-N007\nCoordinadora / Dos interlocutores del\nespacio / Mediadora de lectura", shape=box, fillcolor="#eff6ff", tooltip="Con mediadora ajusta texto que parecía taller con entrega obligatoria. Con anfitriones revisa día, hora y referencia; incorpora puerta junto al patio que la dirección sola no aclaraba."];
"P01-E03-N008" [id="P01-E03-N008", label="Confirmar lo que permite\nanunciar\nP01-E03-N008\nCoordinadora / Dos interlocutores del\nespacio / Mediadora de lectura /\nCompañera de programación", shape=diamond, fillcolor="#fef3c7", tooltip="Consideran adecuada la tarde en salón con tres fechas, equipo, interés posible y recepción acordados. Resume acuerdos, anota calendario y comparte. Aún pueden elegir lecturas o número de hojas."];
"P01-E03-N009" [id="P01-E03-N009", label="Difundir una invitación abierta\nP01-E03-N009\nCoordinadora / Dos interlocutores del\nespacio", shape=box, fillcolor="#eff6ff", tooltip="Tras confirmar tres fechas, anfitriones comparten en canales habituales y colocan invitación visible; equipo difunde entre contactos culturales."];
"P01-E03-N010" [id="P01-E03-N010", label="Preparar salón, materiales y\nllegada\nP01-E03-N010\nCoordinadora / Dos interlocutores del\nespacio / Mediadora de lectura", shape=box, fillcolor="#eff6ff", tooltip="Coordinadora y mediadora llegan antes; anfitriones muestran mobiliario. Acomodan para verse y dejan hojas accesibles; llevan material adicional y un acomodo posible ante más gente."];
"P01-E03-N011" [id="P01-E03-N011", label="Recibir y sostener la\nparticipación\nP01-E03-N011\nCoordinadora / Mediadora de lectura /\nAsistentes de los encuentros", shape=box, fillcolor="#eff6ff", tooltip="La coordinadora recibe, explica y ayuda mientras participa desde su función. En las sesiones hay escucha, conversación o escritura sin producto obligatorio ni formas superiores."];
"P01-E03-N012" [id="P01-E03-N012", label="Ajustar puerta y sillas durante\nsesión\nP01-E03-N012\nCoordinadora / Dos interlocutores del\nespacio / Mediadora de lectura", shape=box, fillcolor="#eff6ff", tooltip="Tras comentario anfitrión sobre apariencia de puerta cerrada, coordinadora y mediadora la dejan entreabierta y mueven sillas. Se siguen oyendo bien; resuelven en pausa sin volver a programación."];
"P01-E03-N013" [id="P01-E03-N013", label="Revisar y aclarar entre\nencuentros\nP01-E03-N013\nCoordinadora / Dos interlocutores del\nespacio / Mediadora de lectura /\nAsistentes de los encuentros", shape=box, fillcolor="#eff6ff", tooltip="Después del primero revisan tiempo e interés y consultan acomodo con anfitriones. Una pregunta sobre llevar texto motiva decir al inicio de siguientes sesiones que escuchar basta y escribir es invitación."];
"P01-E03-N014" [id="P01-E03-N014", label="Adaptar la entrada cultural del\nsegundo\nP01-E03-N014\nMediadora de lectura / Asistentes de\nlos encuentros", shape=box, fillcolor="#eff6ff", tooltip="La conversación sobre caminar al ritmo de otra persona orienta a la mediadora hacia escribir una escena del trayecto, sin abandonar lectura ni cambiar completamente actividad."];
"P01-E03-N015" [id="P01-E03-N015", label="Continuar con entradas autónomas\nP01-E03-N015\nCoordinadora / Mediadora de lectura /\nAsistentes de los encuentros", shape=box, fillcolor="#eff6ff", tooltip="Segundo y tercero conservan lugar, horario y acomodo semejante. En tercero retoman lo previo sin exigir asistencia anterior; cada sesión tiene entrada completa y el equipo sostiene memoria."];
"P01-E03-N016" [id="P01-E03-N016", label="Cerrar la tercera sesión y\nrecoger\nP01-E03-N016\nCoordinadora / Mediadora de lectura /\nAsistentes de los encuentros", shape=box, fillcolor="#eff6ff", tooltip="Comunican que termina la serie acordada, dejan comentarios voluntarios y después acomodan el salón."];
"P01-E03-N017" [id="P01-E03-N017", label="Valorar con anfitriones y\nconsultar equipo\nP01-E03-N017\nCoordinadora / Dos interlocutores del\nespacio / Equipo de la organización", shape=box, fillcolor="#eff6ff", tooltip="En otro momento conversa sobre cómo resultó recibirlos. Lleva al equipo el interés por continuar y acuerdan considerar otra propuesta al revisar programación."];
"P01-E03-N018" [id="P01-E03-N018", label="Comunicar interés sin nueva\nfecha\nP01-E03-N018\nCoordinadora / Dos interlocutores del\nespacio / Asistentes de los encuentros", shape=oval, fillcolor="#e2e8f0", tooltip="Devuelve a anfitriones que hay interés, sin fecha ni repetición comprometida; a quienes preguntan se indica canal habitual si hubiera algo más. Una propuesta de lectura propia queda anotada sin decidir hacerla."];
"P01-E03-N001" -> "P01-E03-N002" [id="P01-E03-R001", label="", tooltip="P01-E03-R001: La invitación y posibilidades iniciales se llevan al equipo."];
"P01-E03-N002" -> "P01-E03-N003" [id="P01-E03-R002", label="Se superponen", tooltip="P01-E03-R002: La propuesta se revisa en capacidad y nuevamente con fechas concretas; no es una fase separada.", style=dotted, dir=none, constraint=false];
"P01-E03-N002" -> "P01-E03-N004" [id="P01-E03-R003", label="\nOrganización analítica", tooltip="P01-E03-R003: Después vuelven al espacio para verlo y hablar de uso; la cláusula de retorno P054 precisa la transición.", color="#a16207", style=dashed];
"P01-E03-N004" -> "P01-E03-N005" [id="P01-E03-R004", label="", tooltip="P01-E03-R004: La experiencia de un día requiere comprobar lo previsto en las tres fechas."];
"P01-E03-N003" -> "P01-E03-N006" [id="P01-E03-R005", label="\nOrganización analítica", tooltip="P01-E03-R005: Cruzan capacidad antes de preguntar a algunas personas.", color="#a16207", style=dashed];
"P01-E03-N006" -> "P01-E03-N007" [id="P01-E03-R006", label="Se superponen", tooltip="P01-E03-R006: Consultas y preparación de contenido se cruzan mientras esperan respuestas.", style=dotted, dir=none, constraint=false];
"P01-E03-N005" -> "P01-E03-N007" [id="P01-E03-R007", label="Se superponen", tooltip="P01-E03-R007: Disponibilidad se termina de comprobar mientras ajustan descripción.", style=dotted, dir=none, constraint=false];
"P01-E03-N003" -> "P01-E03-N008" [id="P01-E03-R008", label="\nOrganización analítica", tooltip="P01-E03-R008: La capacidad y calendario alimentan el acuerdo que permite invitar.", color="#a16207", style=dashed];
"P01-E03-N005" -> "P01-E03-N008" [id="P01-E03-R009", label="Se confirma salón para las\ntres fechas.", tooltip="P01-E03-R009: Confirmar tres fechas es condición explícita del anuncio."];
"P01-E03-N006" -> "P01-E03-N008" [id="P01-E03-R010", label="\nOrganización analítica", tooltip="P01-E03-R010: Las respuestas acotadas sustentan esta serie, sin encuesta comunitaria.", color="#a16207", style=dashed];
"P01-E03-N004" -> "P01-E03-N008" [id="P01-E03-R011", label="\nOrganización analítica", tooltip="P01-E03-R011: La visita complementa confirmaciones, sin determinar por sí sola disponibilidad.", color="#a16207", style=dashed];
"P01-E03-N007" -> "P01-E03-N008" [id="P01-E03-R012", label="\nOrganización analítica", tooltip="P01-E03-R012: El acuerdo puede cerrarse aunque queden lecturas y cantidad de hojas.", color="#a16207", style=dashed];
"P01-E03-N008" -> "P01-E03-N009" [id="P01-E03-R013", label="Lugar, fechas, equipo y\nrecepción acordados.", tooltip="P01-E03-R013: No circula la invitación antes de confirmación; se distingue preparar de anunciar."];
"P01-E03-N009" -> "P01-E03-N010" [id="P01-E03-R014", label="\nOrganización analítica", tooltip="P01-E03-R014: La preparación situada del primer encuentro sucede dentro de la serie ya invitada.", color="#a16207", style=dashed];
"P01-E03-N010" -> "P01-E03-N011" [id="P01-E03-R015", label="", tooltip="P01-E03-R015: Llegan antes y acomodan para recibir durante la sesión."];
"P01-E03-N011" -> "P01-E03-N012" [id="P01-E03-R016", label="Se superponen", tooltip="P01-E03-R016: Ajuste operativo durante sesión a partir de comentario; no escala a programación.", style=dotted, dir=none, constraint=false];
"P01-E03-N011" -> "P01-E03-N013" [id="P01-E03-R017", label="", tooltip="P01-E03-R017: Conversación entre primero y segundo recupera experiencia y pregunta individual."];
"P01-E03-N013" -> "P01-E03-N011" [id="P01-E03-R018", label="Retorno", tooltip="P01-E03-R018: Se lleva la aclaración de participación al inicio de encuentros siguientes.", style=dashed, color="#2563eb", constraint=false, xlabel="P01-E03-R018"];
"P01-E03-N013" -> "P01-E03-N014" [id="P01-E03-R019", label="\nOrganización analítica", tooltip="P01-E03-R019: Se distingue revisión entre sesiones de la adaptación ocurrida en el segundo; relación de ubicación narrativa.", color="#a16207", style=dashed];
"P01-E03-N014" -> "P01-E03-N015" [id="P01-E03-R020", label="Se superponen", tooltip="P01-E03-R020: La adaptación del segundo ocurre dentro de una continuidad que no requiere retorno de todos.", style=dotted, dir=none, constraint=false];
"P01-E03-N013" -> "P01-E03-N015" [id="P01-E03-R021", label="", tooltip="P01-E03-R021: Las precisiones se incorporan a las siguientes sesiones."];
"P01-E03-N015" -> "P01-E03-N016" [id="P01-E03-R022", label="", tooltip="P01-E03-R022: La tercera retoma sin exigir memoria y anuncia final de serie."];
"P01-E03-N016" -> "P01-E03-N017" [id="P01-E03-R023", label="", tooltip="P01-E03-R023: Después de acomodar conversa con anfitriones en otro momento y lleva su interés al equipo."];
"P01-E03-N017" -> "P01-E03-N018" [id="P01-E03-R024", label="", tooltip="P01-E03-R024: Luego comunica el alcance real de lo acordado, sin nueva fecha."];
{ rank=same; "P01-E03-N002"; "P01-E03-N003"; }
{ rank=same; "P01-E03-N006"; "P01-E03-N007"; }
{ rank=same; "P01-E03-N011"; "P01-E03-N012"; }
{ rank=same; "P01-E03-N014"; "P01-E03-N015"; }
}
