digraph proceso {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", labelloc="t", label="Revisar tres registros de lugares para una relación de visitas · E01\nProceso descrito según la entrevista"];
node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b", fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#475569", arrowsize=0.7];
"P01-E01-N001" [id="P01-E01-N001", label="Recibir la petición y la\nrelación\nP01-E01-N001\nTécnica de registros / Solicitante de\nrevisión", shape=oval, fillcolor="#dcfce7", tooltip="La recepción de tabla y petición de revisar tres espacios marca el inicio propio; no se reconstruyen las conversaciones anteriores."];
"P01-E01-N002" [id="P01-E01-N002", label="Delimitar qué debe devolver\nP01-E01-N002\nTécnica de registros / Solicitante de\nrevisión", shape=box, fillcolor="#eff6ff", tooltip="Entiende que prepara una copia revisada para reconocer sitios, sin organizar las visitas."];
"P01-E01-N003" [id="P01-E01-N003", label="Buscar y comparar los tres\nsitios\nP01-E01-N003\nTécnica de registros", shape=box, fillcolor="#eff6ff", tooltip="Busca registros, compara nombres y referencias y abre cada ubicación en el mapa; contrasta si se trata de los mismos sitios."];
"P01-E01-N004" [id="P01-E01-N004", label="Conservar uno y ajustar otra\nreferencia\nP01-E01-N004\nTécnica de registros", shape=box, fillcolor="#eff6ff", tooltip="El primer registro coincide y se conserva; en el segundo sustituye un comercio que ya no orienta por una referencia del equipo, sin mover ubicación. Termina ambos mientras espera la aclaración del tercero."];
"P01-E01-N005" [id="P01-E01-N005", label="Precisar la duda del tercer\nsitio\nP01-E01-N005\nTécnica de registros", shape=diamond, fillcolor="#fef3c7", tooltip="Coinciden nombre y croquis, pero cambia la calle de entrada. Considera mismo espacio, descripción incompleta u otro sitio; la posibilidad de coincidencia no basta."];
"P01-E01-N006" [id="P01-E01-N006", label="Releer antecedentes con la\ncompañera\nP01-E01-N006\nTécnica de registros / Compañera de\nrevisión", shape=box, fillcolor="#eff6ff", tooltip="Recupera una nota de la esquina y consulta otra lectura. La compañera devuelve la atención a lo representado: el sitio, no una puerta. La primera intención de mover el punto no se ejecutó."];
"P01-E01-N007" [id="P01-E01-N007", label="Enviar la pregunta y esperar\naclaración\nP01-E01-N007\nTécnica de registros / Solicitante de\nrevisión / Equipo del recorrido", shape=box, fillcolor="#eff6ff", tooltip="Formula la duda de identidad, acceso utilizado o traslado y la transmite por la solicitante. Queda esperando la respuesta del equipo, que se representa en la acción siguiente; durante esa espera termina los otros dos registros."];
"P01-E01-N008" [id="P01-E01-N008", label="Recibir y contrastar la\naclaración\nP01-E01-N008\nTécnica de registros / Solicitante de\nrevisión / Equipo del recorrido", shape=box, fillcolor="#eff6ff", tooltip="La solicitante comunica que visitaron el mismo espacio, por el costado; el croquis coincide y no se informa traslado. No se confirma el otro acceso."];
"P01-E01-N009" [id="P01-E01-N009", label="Decidir qué conservar y qué\ncambiar\nP01-E01-N009\nTécnica de registros", shape=diamond, fillcolor="#fef3c7", tooltip="Combina nombre, esquina del croquis, descripción previa y respuesta. Ese respaldo basta para conservar registro y punto y ajustar únicamente la referencia de acceso."];
"P01-E01-N010" [id="P01-E01-N010", label="Ajustar la copia y guardar el\nrespaldo\nP01-E01-N010\nTécnica de registros", shape=box, fillcolor="#eff6ff", tooltip="Cambia descripción de acceso, mantiene identificador y ubicación, deja observación sobre el recorrido y guarda la aclaración con lo recibido. No escribe acceso único ni cancelación."];
"P01-E01-N011" [id="P01-E01-N011", label="Releer el conjunto y limitar lo\nafirmado\nP01-E01-N011\nTécnica de registros", shape=box, fillcolor="#eff6ff", tooltip="Relee los tres registros seguidos, revisa identificador, ubicación conservada y que la descripción no exceda lo sabido."];
"P01-E01-N012" [id="P01-E01-N012", label="Devolver la copia con\nexplicación breve\nP01-E01-N012\nTécnica de registros / Solicitante de\nrevisión", shape=box, fillcolor="#eff6ff", tooltip="Devuelve copia y explicación de conservación, sustitución de referencia y precisión del acceso usado; no envía toda la conversación interna."];
"P01-E01-N013" [id="P01-E01-N013", label="Explicar la diferencia de calle\nP01-E01-N013\nTécnica de registros / Solicitante de\nrevisión", shape=box, fillcolor="#eff6ff", tooltip="Tras recibir la copia, la persona pregunta por la calle escrita. Explica que sigue siendo el mismo espacio y se incorporó la referencia del recorrido."];
"P01-E01-N014" [id="P01-E01-N014", label="Dar por atendida su revisión\nP01-E01-N014\nTécnica de registros", shape=oval, fillcolor="#e2e8f0", tooltip="Para esta voz el episodio cierra al devolver la copia y responder esa pregunta; no siguió las visitas ni asegura cómo usaron la relación."];
"P01-E01-N015" [id="P01-E01-N015", label="Reconocer la copia de una nueva\nconsulta\nP01-E01-N015\nTécnica de registros\nPráctica general declarada", shape=box, fillcolor="#eff6ff", tooltip="Como práctica general, identifica la versión que ve quien pregunta y la referencia dudosa antes de explicar; no consta que fuera necesario identificar dos versiones en el episodio."];
"P01-E01-N001" -> "P01-E01-N002" [id="P01-E01-R001", label="\nOrganización analítica", tooltip="P01-E01-R001: La petición recibida delimita qué revisar; se separan recepción y comprensión por claridad analítica.", color="#a16207", style=dashed];
"P01-E01-N002" -> "P01-E01-N003" [id="P01-E01-R002", label="", tooltip="P01-E01-R002: La búsqueda es la primera acción con lo recibido."];
"P01-E01-N003" -> "P01-E01-N004" [id="P01-E01-R003", label="", tooltip="P01-E01-R003: El contraste permite conservar o modificar referencias; ambos se terminan durante la espera."];
"P01-E01-N003" -> "P01-E01-N005" [id="P01-E01-R004", label="La calle de entrada difiere\ny no basta la coincidencia\nposible.", tooltip="P01-E01-R004: La diferencia de acceso requiere precisar la identidad."];
"P01-E01-N003" -> "P01-E01-N005" [id="P01-E01-R005", label="Se superponen", tooltip="P01-E01-R005: La pregunta se anotaba mientras comparaba.", style=dotted, dir=none, constraint=false];
"P01-E01-N005" -> "P01-E01-N006" [id="P01-E01-R006", label="Retorno", tooltip="P01-E01-R006: La discrepancia hace volver a antecedentes y a la lectura de la compañera.", style=dashed, color="#2563eb", constraint=false, constraint=true, xlabel="P01-E01-R006"];
"P01-E01-N005" -> "P01-E01-N007" [id="P01-E01-R007", label="Intercambio mediado", tooltip="P01-E01-R007: La duda formulada se transmite por la solicitante."];
"P01-E01-N007" -> "P01-E01-N008" [id="P01-E01-R008", label="Intercambio mediado", tooltip="P01-E01-R008: La respuesta del equipo llega por la solicitante."];
"P01-E01-N004" -> "P01-E01-N007" [id="P01-E01-R009", label="Se superponen", tooltip="P01-E01-R009: Terminar los otros dos y esperar la respuesta del tercero se superponen; la línea no fija precedencia.", style=dotted, dir=none, constraint=false];
"P01-E01-N006" -> "P01-E01-N009" [id="P01-E01-R010", label="\nOrganización analítica", tooltip="P01-E01-R010: La lectura de antecedentes es uno de los apoyos de la decisión; no se fija su orden respecto de la aclaración final.", color="#a16207", style=dashed];
"P01-E01-N008" -> "P01-E01-N009" [id="P01-E01-R011", label="", tooltip="P01-E01-R011: La aclaración resuelve la duda pertinente y completa los apoyos."];
"P01-E01-N009" -> "P01-E01-N010" [id="P01-E01-R012", label="", tooltip="P01-E01-R012: Decisión efectuada: conservar identificación y ubicación, modificar descripción."];
"P01-E01-N010" -> "P01-E01-N011" [id="P01-E01-R013", label="", tooltip="P01-E01-R013: Revisa lo que va a entregar después del ajuste."];
"P01-E01-N004" -> "P01-E01-N011" [id="P01-E01-R014", label="\nOrganización analítica", tooltip="P01-E01-R014: La relectura conjunta incluye también los dos registros directos.", color="#a16207", style=dashed];
"P01-E01-N011" -> "P01-E01-N012" [id="P01-E01-R015", label="", tooltip="P01-E01-R015: La copia se devuelve después de releer y comprobar."];
"P01-E01-N012" -> "P01-E01-N013" [id="P01-E01-R016", label="Retorno", tooltip="P01-E01-R016: La duda regresa desde la copia recibida; no es una nueva visita ni un nuevo encargo.", style=dashed, color="#2563eb", constraint=false, constraint=true, xlabel="P01-E01-R016"];
"P01-E01-N013" -> "P01-E01-N014" [id="P01-E01-R017", label="", tooltip="P01-E01-R017: Con la explicación posterior se da por atendida su parte."];
{ rank=same; "P01-E01-N006"; "P01-E01-N007"; }
}
