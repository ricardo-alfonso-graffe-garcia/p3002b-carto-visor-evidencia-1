digraph proceso {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", labelloc="t", label="Reponer elástico conocido y conservar una consulta de alternativa · E04\nProceso descrito según la entrevista"];
node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b", fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#475569", arrowsize=0.7];
"P01-E04-N001" [id="P01-E04-N001", label="Revisar el rollo después de una\nventa\nP01-E04-N001\nPersona que atiende y compra", shape=oval, fillcolor="#dcfce7", tooltip="La salida empieza a organizarse al revisar remanente de elástico conocido después de vender otro corte; la petición de suavidad ya estaba anotada antes."];
"P01-E04-N002" [id="P01-E04-N002", label="Medir y confirmar la reposición\nP01-E04-N002\nPersona que atiende y compra", shape=diamond, fillcolor="#fef3c7", tooltip="Revisa otros elásticos, mide el reducido y confirma mantenerlo en lista; alcanza para vender mientras compra, sin salir de inmediato ni llenar toda sección."];
"P01-E04-N003" [id="P01-E04-N003", label="Identificar y agrupar lo que\ncomprará\nP01-E04-N003\nPersona que atiende y compra / Otra\npersona del mostrador", shape=box, fillcolor="#eff6ff", tooltip="Anota color/ancho, busca referencia anterior y comenta lista con otra persona; juntan compras del mismo lugar y separan las de otros proveedores."];
"P01-E04-N004" [id="P01-E04-N004", label="Preparar muestra, consulta y\nrelevo\nP01-E04-N004\nPersona que atiende y compra / Otra\npersona del mostrador", shape=box, fillcolor="#eff6ff", tooltip="Prepara muestra y referencia, acuerdan cuándo sale, revisa lista antes de salir y agrega preguntar por más suave separado de compra comprometida."];
"P01-E04-N005" [id="P01-E04-N005", label="Continuar la atención durante\nausencia\nP01-E04-N005\nPersona que atiende y compra / Otra\npersona del mostrador\nPráctica general declarada", shape=box, fillcolor="#eff6ff", tooltip="La otra persona atiende, mide e informa sin esperar autorización para cada venta; puede consultar puntualmente. Al regreso se comparte lo ocurrido en ambos sentidos."];
"P01-E04-N006" [id="P01-E04-N006", label="Pedir y comparar el rollo\nconocido\nP01-E04-N006\nPersona que atiende y compra / Persona\ndel proveedor", shape=box, fillcolor="#eff6ff", tooltip="En proveedor pide primero referencia conocida; le muestran rollo y compara muestra, ancho y estiramiento."];
"P01-E04-N007" [id="P01-E04-N007", label="Consultar y tocar la alternativa\nP01-E04-N007\nPersona que atiende y compra / Persona\ndel proveedor", shape=box, fillcolor="#eff6ff", tooltip="Después pregunta por más suave del mismo ancho, toca y estira junto al otro. Reconoce diferencia, pero no conoce prenda ni cómo se coserá."];
"P01-E04-N008" [id="P01-E04-N008", label="No incorporar otro rollo y\nguardar referencia\nP01-E04-N008\nPersona que atiende y compra / Persona\ndel proveedor", shape=diamond, fillcolor="#fef3c7", tooltip="Pregunta precio y presentación: exige más cantidad de la deseada para conocerlo. No compra alternativa y anota referencia; no es decisión de sustituir ni descarte definitivo."];
"P01-E04-N009" [id="P01-E04-N009", label="Comprar el mismo con respaldo\nsuficiente\nP01-E04-N009\nPersona que atiende y compra / Persona\ndel proveedor", shape=diamond, fillcolor="#fef3c7", tooltip="Trae el que debía reponer: referencia y muestra coinciden, no observa diferencias en parte mostrada y conoce manejo de medir/cortar."];
"P01-E04-N010" [id="P01-E04-N010", label="Terminar la vuelta y regresar\nP01-E04-N010\nPersona que atiende y compra", shape=box, fillcolor="#eff6ff", tooltip="No visita el otro proveedor cercano: resolvió reposición, no había encargo confirmado de alternativa y debía regresar. Sabía llegar a ambos."];
"P01-E04-N011" [id="P01-E04-N011", label="Cotejar compra e informar\nconsulta\nP01-E04-N011\nPersona que atiende y compra / Otra\npersona del mostrador", shape=box, fillcolor="#eff6ff", tooltip="Antes de guardar verifica lo traído con lista, mira nuevo rollo con la otra persona, cuenta que preguntó sin comprar alternativa y deja su referencia con nota."];
"P01-E04-N012" [id="P01-E04-N012", label="Ordenar existencias y conservar\nreferencias\nP01-E04-N012\nPersona que atiende y compra / Otra\npersona del mostrador", shape=box, fillcolor="#eff6ff", tooltip="Separa por sección, guarda por ancho, deja rollo abierto delante y no mezcla pedazos. Mantiene muestra, sección y letrero porque es el mismo artículo."];
"P01-E04-N013" [id="P01-E04-N013", label="Terminar anterior y apartar\nrecorte\nP01-E04-N013\nPersona que atiende y compra / Otra\npersona del mostrador", shape=box, fillcolor="#eff6ff", tooltip="Se agota primero la unidad anterior; separan pedazo corto con recortes y no lo cuentan disponible para cualquier medida."];
"P01-E04-N014" [id="P01-E04-N014", label="Abrir y despachar del rollo\nnuevo\nP01-E04-N014\nPersona que atiende y compra / Otra\npersona del mostrador", shape=box, fillcolor="#eff6ff", tooltip="Después abren nuevo para venta; al cortarlo comprueba manejo y no nota diferencia con anterior."];
"P01-E04-N015" [id="P01-E04-N015", label="Reconocer completada la\nreposición\nP01-E04-N015\nPersona que atiende y compra", shape=oval, fillcolor="#e2e8f0", tooltip="Primer despacho incorpora nuevo rollo a lo vendido y cierra reposición; no espera venderlo entero. La consulta alternativa queda conservada sin tarea diaria."];
"P01-E04-N016" [id="P01-E04-N016", label="Conservar surtido según su\nfunción\nP01-E04-N016\nPersona que atiende y compra\nPráctica general declarada", shape=box, fillcolor="#eff6ff", tooltip="Declara que a veces piezas de poca venta convienen por ser específicas; remanente, espacio y alternativas varían por artículo."];
"P01-E04-N001" -> "P01-E04-N002" [id="P01-E04-R001", label="", tooltip="P01-E04-R001: Revisión y medida confirman necesidad, no urgencia."];
"P01-E04-N001" -> "P01-E04-N003" [id="P01-E04-R002", label="", tooltip="P01-E04-R002: Al revisar tras venta anota descripción y luego comparte lista. No fija posición de la medida respecto de reunir otras compras."];
"P01-E04-N002" -> "P01-E04-N004" [id="P01-E04-R003", label="\nOrganización analítica", tooltip="P01-E04-R003: Confirmar reposición y preparar identificación sostienen la salida; no se presupone medir antes de describir y agrupar lista.", color="#a16207", style=dashed];
"P01-E04-N003" -> "P01-E04-N004" [id="P01-E04-R004", label="", tooltip="P01-E04-R004: Referencia y muestra preparadas, luego acuerdan salida y separa consulta."];
"P01-E04-N006" -> "P01-E04-N005" [id="P01-E04-R005", label="Se superponen\nOrganización analítica", tooltip="P01-E04-R005: La práctica general de continuidad en el mostrador contextualiza la ausencia durante la visita al proveedor. No se afirma que atender se solapara específicamente con preparar la muestra ni se enumeran ventas de ese día.", style=dotted, dir=none, constraint=false, color="#a16207", style=dashed];
"P01-E04-N004" -> "P01-E04-N006" [id="P01-E04-R006", label="", tooltip="P01-E04-R006: Al llegar pide primero conocido con referencia y muestra."];
"P01-E04-N006" -> "P01-E04-N007" [id="P01-E04-R007", label="", tooltip="P01-E04-R007: Después pregunta por más suave del mismo ancho."];
"P01-E04-N007" -> "P01-E04-N008" [id="P01-E04-R008", label="", tooltip="P01-E04-R008: Oferta de precio/presentación conduce a no incorporar y guardar referencia."];
"P01-E04-N006" -> "P01-E04-N009" [id="P01-E04-R009", label="\nOrganización analítica", tooltip="P01-E04-R009: Comparación del conocido respalda su compra; no exige comparación jerárquica con alternativa.", color="#a16207", style=dashed];
"P01-E04-N008" -> "P01-E04-N010" [id="P01-E04-R010", label="", tooltip="P01-E04-R010: Consulta termina sin otra parada porque no es encargo y debía regresar."];
"P01-E04-N009" -> "P01-E04-N010" [id="P01-E04-R011", label="", tooltip="P01-E04-R011: Reposición resuelta permite cerrar vuelta sin buscar otras opciones."];
"P01-E04-N010" -> "P01-E04-N011" [id="P01-E04-R012", label="", tooltip="P01-E04-R012: Al regreso compara con lista antes de guardar e informa lo consultado."];
"P01-E04-N005" -> "P01-E04-N011" [id="P01-E04-R013", label="\nOrganización analítica", tooltip="P01-E04-R013: La devolución al regreso hace recíproco el relevo; no añade consultas o ventas concretas desconocidas.", color="#a16207", style=dashed];
"P01-E04-N011" -> "P01-E04-N012" [id="P01-E04-R014", label="", tooltip="P01-E04-R014: Tras cotejo separa por sección y ordena unidades."];
"P01-E04-N012" -> "P01-E04-N013" [id="P01-E04-R015", label="", tooltip="P01-E04-R015: Mantiene primero abierto hasta terminarlo y apartar recorte."];
"P01-E04-N013" -> "P01-E04-N014" [id="P01-E04-R016", label="", tooltip="P01-E04-R016: Después abre nuevo rollo para una venta."];
"P01-E04-N014" -> "P01-E04-N015" [id="P01-E04-R017", label="", tooltip="P01-E04-R017: Primer corte y manejo sin diferencia sostienen cierre propio."];
{ rank=same; "P01-E04-N002"; "P01-E04-N003"; "P01-E04-N016"; }
{ rank=same; "P01-E04-N005"; "P01-E04-N006"; }
{ rank=same; "P01-E04-N008"; "P01-E04-N009"; }
}
